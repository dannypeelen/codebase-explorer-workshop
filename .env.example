# Copy to .env and fill in. Never commit the real .env (already in .gitignore).

# --- Gemini (required for Exercises 1, 3, 4; Exercise 2 and graph browsing
# don't need it at all) ---
# Get a free key at https://aistudio.google.com/app/apikey — the free tier
# (~100 embed_content calls/minute, ~5 generate_content calls/minute and
# 20/day) is enough for this workshop; see README.md's troubleshooting
# section if you hit a quota wall mid-workshop.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=1536           # must match data/flask_embeddings.json's vectors — don't change this
GEMINI_MODEL=gemini-3.6-flash       # Gemini model names move fast; if generation calls 404, check
                                     # https://ai.google.dev/gemini-api/docs/models for the current name
LLM_MAX_CALLS=500                   # hard cap on Gemini calls per backend process — cost control

# --- backend ---
VISUAL_ORIGIN=http://localhost:5173 # CORS allowlist for the frontend dev server

# --- frontend (Vite only reads VITE_-prefixed vars; set in frontend/.env) ---
# VITE_API_URL=http://localhost:8000
